<?xml version="1.0" encoding="UTF-8"?>
<!-- Regional artwork (images/br/). Generated by tools/update-regions.sh. -->
<theme>
    <variables>
        <systemLogo>./platforms/dreamcast/images/br/logo.svg</systemLogo>
        <gamelistLogo>./platforms/dreamcast/images/br/logo.svg</gamelistLogo>
    </variables>
    <variables if="${logoVariantSystem} == 'white'">
        <systemLogo>./platforms/dreamcast/images/br/logo-w.svg</systemLogo>
    </variables>
    <variables if="${logoVariantGamelist} == 'white'">
        <gamelistLogo>./platforms/dreamcast/images/br/logo-w.svg</gamelistLogo>
    </variables>
</theme>
