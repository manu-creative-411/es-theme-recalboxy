<?xml version="1.0" encoding="UTF-8"?>
<theme>
    <variables>
        <!-- Assets taken from Carbon (see CREDITS.md) -->
        <systemLogo>./platforms/soh/images/logo.webp</systemLogo>
        <gamelistLogo>./platforms/soh/images/logo.webp</gamelistLogo>
        <band1>2E7D32</band1>
        <band2>F2C230</band2>
        <band3>E8E8E8</band3>
        <band4>1A1A1A</band4>
    </variables>
    <variables if="${logoVariantSystem} == 'white'">
        <systemLogo>./platforms/soh/images/logo-w.webp</systemLogo>
    </variables>
    <variables if="${logoVariantGamelist} == 'white'">
        <gamelistLogo>./platforms/soh/images/logo-w.webp</gamelistLogo>
    </variables>
</theme>
